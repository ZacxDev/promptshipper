# promptshipper compose settings. ./setup writes .env for you (and keeps your
# tokens across re-runs); copy this by hand only if you are not using ./setup.
# Every blank value falls back to the default named beside it.

# Which stt variant runs: cpu (faster-whisper, any machine) or gpu (cohere).
COMPOSE_PROFILES=cpu

# The address your phone uses to reach this machine (a Tailscale IP or a LAN
# IP). Goes into the pairing QR code; not read by the containers.
PROMPTSHIPPER_HOST=
# The host address the ports are published on. 127.0.0.1 = this machine only.
# ./setup sets it to the (private) --host address, e.g. the Tailscale IP, so it
# listens on the tailnet only. 0.0.0.0 = every interface — never on a machine
# reachable from the internet.
BIND=127.0.0.1
STT_PORT=8118
CLIP_PORT=8139

# Bearer tokens. LEFT BLANK, the services stay CLOSED: stt answers 503 on
# every authenticated route and clip refuses to start. Generate with e.g.
#   openssl rand -hex 32
STT_API_TOKEN=
CLIPSTORE_TOKEN=

# stt backend (cpu profile): faster-whisper | openai | fake
STT_BACKEND=faster-whisper
# Model. faster-whisper default: small. Try base or tiny on a slow machine.
STT_MODEL=
# Upload limits (blank = defaults: 3600 s of audio; a body cap derived from it).
STT_MAX_AUDIO_SECONDS=
STT_MAX_UPLOAD_BYTES=
# Every other server setting (server/stt/README.md) can be added here too;
# compose passes them all through.
# Reliability thresholds. Blank = the backend's default; "off" = rule disabled.
STT_NO_SPEECH_MAX=
STT_AVG_LOGPROB_MIN=

# openai backend only: an OpenAI-compatible upstream to forward to.
STT_UPSTREAM_URL=
STT_UPSTREAM_TOKEN=
STT_UPSTREAM_MODEL=

# gpu profile only: Hugging Face token for the gated cohere model.
HF_TOKEN=

# Images are built locally from this checkout (PULL_POLICY=build). Once
# releases are published you can set PULL_POLICY=missing to pull from GHCR.
PULL_POLICY=build
PROMPTSHIPPER_VERSION=latest
