<?xml version="1.0" encoding="utf-8"?>
<!--
  Pair with a server: scan the QR code `./setup` prints, or paste the same
  payload (docs/pairing.md). PairingActivity validates it, shows what it is
  about to save, and writes nothing until @id/pair_confirm is pressed.

  🔴 @id/pairing_input holds two bearer tokens while it is filled:
  saveEnabled="false" keeps them out of the saved instance state,
  textVisiblePassword|textNoSuggestions keeps the keyboard from learning them,
  and PairingActivity clears the field the moment a pairing is applied.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dicta_surface_0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/Text.Dicta.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pairing_title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/pairing_intro"
            android:textSize="15sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/dicta_on_surface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pairing_scan"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="110dp"
                android:background="@drawable/outline_button_bg"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/dicta_on_surface"
                android:text="@string/pairing_scan" />

            <Button
                android:id="@+id/pairing_paste"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:minWidth="110dp"
                android:background="@drawable/outline_button_bg"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/dicta_on_surface"
                android:text="@string/pairing_paste" />
        </LinearLayout>

        <EditText
            android:id="@+id/pairing_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="96dp"
            android:gravity="top|start"
            android:background="@drawable/input_bg"
            android:padding="14dp"
            android:textSize="13sp"
            android:typeface="monospace"
            android:textColor="@color/dicta_on_surface"
            android:textColorHint="@color/dicta_on_surface_variant"
            android:hint="@string/pairing_input_hint"
            android:importantForAutofill="no"
            android:saveEnabled="false"
            android:inputType="textMultiLine|textNoSuggestions|textVisiblePassword" />

        <TextView
            android:id="@+id/pairing_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/dicta_on_surface_variant" />

        <!-- Offered, never pre-checked: see DictationClipFeed. -->
        <CheckBox
            android:id="@+id/pairing_feed_dictations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:textSize="14sp"
            android:textColor="@color/dicta_on_surface"
            android:text="@string/clip_feed_dictations_label" />

        <Button
            android:id="@+id/pair_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:minWidth="110dp"
            android:enabled="false"
            android:background="@drawable/outline_button_bg"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/dicta_on_surface"
            android:text="@string/pairing_confirm" />
    </LinearLayout>
</ScrollView>
