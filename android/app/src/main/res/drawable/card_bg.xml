<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating dictation card: elevation level 2 of the surface ramp
  (@color/dicta_surface_2) inside a 2dp @color/dicta_accent ring.

  🔴 The ring CHANGED from a 1dp @color/dicta_divider hairline. The card now
  matches the bubble that opens it (@drawable/bubble_bg: the same surface_2
  fill, the same 2dp ember ring), so the two read as one object in two sizes.
  The old note that "a 3:1 boundary here would read as a frame" is retracted
  on purpose — the frame is the point now: it is the identity cue, not a
  separator. The dim still does the separating from the app behind.

  Radius 24dp so the card reads as the same family as the 28dp mic pill and
  the 16dp field; the ScrollView that draws this sets clipToOutline="true" so
  the scrolling content is clipped to these corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dicta_surface_2" />
    <corners android:radius="24dp" />
    <stroke android:width="2dp" android:color="@color/dicta_accent" />
</shape>
