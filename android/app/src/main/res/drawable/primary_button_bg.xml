<?xml version="1.0" encoding="utf-8"?>
<!--
  The card's PRIMARY action (Copy): a solid ember fill.

  The one icon control on the card filled with @color/dicta_accent, so the
  thing the card exists for — getting the transcript out — is the one that
  stands out. The glyph is tinted @color/dicta_on_accent, which measures
  8.85:1 on the accent fill and 6.71:1 on the pressed fill below.

  Pressed DARKENS to @color/dicta_accent_pressed rather than lifting to a
  surface step: a primary control that turned dark-grey when pressed would read
  as being disabled under the finger. Radius 16dp matches icon_button_bg, so
  the row stays one family. A separate drawable rather than a state of
  icon_button_bg, because the secondary controls must not inherit it.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dicta_accent_pressed" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dicta_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
