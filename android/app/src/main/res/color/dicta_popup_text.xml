<?xml version="1.0" encoding="utf-8"?>
<!--
  Text colour for the card's overflow menu items.

  A STATE list, not a plain colour, because one of the items (Save audio) is
  DISABLED until the card has a filed recording behind it, and a plain colour
  would draw the disabled item exactly like the enabled ones. Disabled is
  @color/dicta_outline (3.51:1 on the surface_2 popup); enabled is
  @color/dicta_on_surface (14.01:1).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/dicta_outline" />
    <item android:color="@color/dicta_on_surface" />
</selector>
