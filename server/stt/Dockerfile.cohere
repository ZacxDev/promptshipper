# promptshipper STT server — GPU image for the opt-in `cohere` backend.
#
# Opt-in; built locally by compose, not published. This image contains no model
# weights: the gated (Apache-2.0) model downloads at first start with your
# HF_TOKEN — see server/stt/README.md.
#
# Torch comes from the base image (it IS the torch/CUDA pin); installing torch
# from PyPI here could silently replace the CUDA build with a CPU one.
FROM pytorch/pytorch:2.11.0-cuda12.8-cudnn9-runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements-cohere.txt .
RUN python -m pip install --break-system-packages --no-cache-dir -r requirements-cohere.txt

COPY app.py check_tokens.py ./
COPY backends/ ./backends/

RUN groupadd --system --gid 10001 stt \
    && useradd --system --uid 10001 --gid 10001 --home-dir /app stt \
    && mkdir -p /models/hf /etc/snip \
    && chown -R 10001:10001 /models /etc/snip
USER 10001
ENV HF_HOME=/models/hf \
    STT_BACKEND=cohere \
    PYTHONUNBUFFERED=1

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
