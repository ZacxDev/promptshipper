#!/usr/bin/env bash
# promptshipper setup — one command from a fresh clone to a running, paired server.
#
#   ./setup                     detect the address, generate tokens, start, verify, print the QR
#   ./setup --host 100.101.102.103
#   ./setup --pairing           re-print the pairing QR/payload from the existing .env
#   ./setup --qr-png FILE       write the QR to FILE (0600) and print only the path
#   ./setup --pairing --for desktop   a clip-only code for desktop tools (no STT token)
#   ./setup --rotate            new tokens (every paired device must re-scan)
#   ./setup --help
#
# Non-interactive: it never prompts. Idempotent: re-running keeps the tokens
# and any setting you do not pass again, and only (re)starts what changed.
#
# Exit codes: 0 ok · 1 usage · 2 a prerequisite is missing · 3 a service did not
# become healthy in time · 4 a service is up but rejected its own token ·
# 5 --qr-png could not write the image.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
COMPOSE_DIR="${ROOT}/deploy/compose"
ENV_FILE="${COMPOSE_DIR}/.env"
EXAMPLE_SNIPPETS="${ROOT}/server/stt/examples/snippets.json"
PAIRING_VERSION=1

usage() {
  cat <<'EOF'
Usage: ./setup [options]

Where the phone reaches this machine:
  --host HOST         address the phone uses (Tailscale IP, LAN IP, IPv6, or a DNS
                      name, which is resolved: the pairing code carries the
                      address). Default: kept from .env, else `tailscale ip -4`,
                      else this machine's primary LAN IP.
  --bind ADDR         host address to publish the ports on. Default: a bind you
                      set before is kept; otherwise the --host address, and ONLY
                      if it is private (RFC 1918, Tailscale/CGNAT, IPv6
                      fd00::/8, loopback) — a public address is refused. Never 0.0.0.0
                      unless you pass it here (with a loud warning).
  --stt-port N        default 8118
  --clip-port N       default 8139

Transcription:
  --cpu               faster-whisper on the CPU (default)
  --gpu               the opt-in cohere backend on an NVIDIA GPU (needs HF_TOKEN
                      for the gated model; see server/stt/README.md)
  --backend NAME      cpu profile backend: faster-whisper | openai | fake
  --model NAME        model name (faster-whisper default: small)
  --upstream-url URL  for --backend openai

Lifecycle:
  --rotate            generate NEW tokens (paired devices must re-scan)
  --no-start          write .env and seed the snippet catalog, start nothing
  --pairing           only print the pairing QR/payload from the existing .env
  --no-qr             print the payload without a QR code
  --for phone|desktop which device the pairing code is for (default phone).
                      desktop: clip endpoint and token ONLY — no STT object, so
                      the STT token stays on the phone. For snip, the MCP server
                      and agents.
  --qr-png PATH       write the pairing QR to PATH as a PNG (mode 0600) and print
                      only the path — never the tokens. Use this when an agent
                      runs setup. Works with --pairing too.
  --timeout SECONDS   how long to wait for health (default 1800; the first start
                      downloads the model)
  --env-file PATH     use PATH instead of deploy/compose/.env
  -h, --help
EOF
}

die() { echo "setup: $*" >&2; exit "${2:-1}"; }
say() { echo "==> $*"; }

# ---------------------------------------------------------------- arguments
opt_host="" opt_bind="" opt_stt_port="" opt_clip_port="" opt_profile="" opt_backend=""
opt_model="" opt_upstream="" rotate=0 start=1 pairing_only=0 qr=1 qr_png="" pair_for=phone timeout=1800
while (($#)); do
  case "$1" in
    --host) opt_host=${2:?--host needs a value}; shift ;;
    --bind) opt_bind=${2:?--bind needs a value}; shift ;;
    --stt-port) opt_stt_port=${2:?--stt-port needs a value}; shift ;;
    --clip-port) opt_clip_port=${2:?--clip-port needs a value}; shift ;;
    --cpu) opt_profile=cpu ;;
    --gpu) opt_profile=gpu ;;
    --backend) opt_backend=${2:?--backend needs a value}; shift ;;
    --model) opt_model=${2:?--model needs a value}; shift ;;
    --upstream-url) opt_upstream=${2:?--upstream-url needs a value}; shift ;;
    --rotate) rotate=1 ;;
    --no-start) start=0 ;;
    --pairing) pairing_only=1 ;;
    --no-qr) qr=0 ;;
    --qr-png) qr_png=${2:?--qr-png needs a path}; shift ;;
    --for) pair_for=${2:?--for needs phone or desktop}; shift ;;
    --timeout) timeout=${2:?--timeout needs a value}; shift ;;
    --env-file) ENV_FILE=${2:?--env-file needs a value}; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
  shift
done
[[ "$timeout" =~ ^[0-9]+$ ]] || die "--timeout must be a number of seconds"
[[ "$pair_for" == phone || "$pair_for" == desktop ]] || die "--for must be phone or desktop"
if [[ -n "$qr_png" ]]; then
  [[ ! -d "$qr_png" ]] || die "--qr-png wants a file path, not a directory"
  [[ -d "$(dirname "$qr_png")" ]] || die "--qr-png: directory $(dirname "$qr_png") does not exist"
fi
for p in "$opt_stt_port" "$opt_clip_port"; do
  [[ -z "$p" || ( "$p" =~ ^[0-9]+$ && p -ge 1 && p -le 65535 ) ]] || die "invalid port: $p"
done
case "$opt_backend" in ""|faster-whisper|openai|fake) ;; *) die "--backend must be faster-whisper, openai or fake" ;; esac

# ---------------------------------------------------------------- .env I/O
# Parsed as KEY=VALUE lines, never `source`d: a .env is data, not a script.
declare -A cfg=()
declare -a extra_lines=()
MANAGED_KEYS=(COMPOSE_PROFILES PROMPTSHIPPER_HOST PAIRING_HOST BIND BIND_AUTO STT_PORT CLIP_PORT
  STT_API_TOKEN CLIPSTORE_TOKEN STT_BACKEND STT_MODEL STT_UPSTREAM_URL PULL_POLICY PROMPTSHIPPER_VERSION)
is_managed() { local k; for k in "${MANAGED_KEYS[@]}"; do [[ "$k" == "$1" ]] && return 0; done; return 1; }

if [[ -f "$ENV_FILE" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key=${BASH_REMATCH[1]} val=${BASH_REMATCH[2]}
      if is_managed "$key"; then cfg[$key]=$val; else extra_lines+=("$line"); fi
    fi
  done <"$ENV_FILE"
fi
get() { printf '%s' "${cfg[$1]:-}"; }

# ---------------------------------------------------------------- addresses
is_ipv4() { [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; }
is_ipv6() { [[ "$1" == *:* && "$1" =~ ^[0-9A-Fa-f:.]+$ ]]; }
is_ip() { is_ipv4 "$1" || is_ipv6 "$1"; }
is_wildcard() { [[ "$1" == 0.0.0.0 || "$1" == "::" ]]; }
# Private = reachable only on a private network. ONE definition, shared with the
# Android app (PrivateNetwork.kt), snip (desktop/snip/internal/shared/cleartext.go)
# and docs/pairing.md, which is what the app will talk plain HTTP to:
#   IPv4 10/8, 172.16/12, 192.168/16, 100.64/10 (CGNAT — Tailscale), 127/8;
#   IPv6 ::1 and fd00::/8 (incl. Tailscale's fd7a:115c:a1e0::/48).
# fd00::/8, NOT all of ULA fc00::/7: fc00::/8 is reserved and unassigned, and a
# narrower setup than the app would let setup accept an address the app refuses.
# Literals are parsed as strictly as the app does: dotted-quad octets 0..255
# with no leading zeros; IPv6 with no zone id (%eth0) and no embedded IPv4.
# Anything else, a DNS name included, is not private.
is_private() {
  local a=$1 o
  if [[ "$a" =~ ^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$ ]]; then
    local -a q=("${BASH_REMATCH[@]:1}")
    for o in "${q[@]}"; do ((o <= 255)) || return 1; done
    ((q[0] == 10 || q[0] == 127)) && return 0
    ((q[0] == 172 && q[1] >= 16 && q[1] <= 31)) && return 0
    ((q[0] == 192 && q[1] == 168)) && return 0
    ((q[0] == 100 && q[1] >= 64 && q[1] <= 127)) && return 0
    return 1
  fi
  local -a g
  ipv6_groups "$a" || return 1
  ((16#${g[0]} >> 8 == 0xfd)) && return 0                   # fd00::/8
  for o in "${g[@]:0:7}"; do ((16#$o == 0)) || return 1; done # ::1
  ((16#${g[7]} == 1))
}
# ipv6_groups LITERAL: fills the CALLER's array `g` with the 8 hex groups, or
# fails. `::` may appear once and stands for at least one zero group.
ipv6_groups() {
  local s head tail grp='([0-9a-f]{1,4}(:[0-9a-f]{1,4})*)?'
  local -a hd=() tl=()
  s=$(printf '%s' "$1" | tr 'A-F' 'a-f')
  if [[ "$s" == *::* ]]; then
    head=${s%%::*} tail=${s#*::}
    [[ "$head" =~ ^${grp}$ && "$tail" =~ ^${grp}$ ]] || return 1
    [[ -n "$head" ]] && IFS=: read -ra hd <<<"$head"
    [[ -n "$tail" ]] && IFS=: read -ra tl <<<"$tail"
    ((${#hd[@]} + ${#tl[@]} <= 7)) || return 1
    g=("${hd[@]}")
    while ((${#g[@]} + ${#tl[@]} < 8)); do g+=(0); done
    g+=("${tl[@]}")
  else
    [[ "$s" =~ ^${grp}$ && -n "$s" ]] || return 1
    IFS=: read -ra g <<<"$s"
    ((${#g[@]} == 8)) || return 1
  fi
}
resolve() { # name -> its first IPv4 address, else first IPv6, else nothing
  local fam addr
  command -v getent >/dev/null 2>&1 || return 0
  for fam in ahostsv4 ahostsv6; do
    addr=$(getent "$fam" "$1" 2>/dev/null | awk 'NR==1{print $1}' || true)
    if is_ip "$addr"; then printf '%s' "$addr"; return 0; fi
  done
}
address_of() { # host -> an IP literal (itself, or what the name resolves to)
  if is_ip "$1"; then printf '%s' "$1"; else resolve "$1"; fi
}
url_for() { # host port -> http://host:port (IPv6 literals bracketed)
  local h=$1
  [[ "$h" == *:* ]] && h="[$h]"
  printf 'http://%s:%s' "$h" "$2"
}

# ---------------------------------------------------------------- pairing
pairing_host() { local h; h=$(get PAIRING_HOST); printf '%s' "${h:-$(get PROMPTSHIPPER_HOST)}"; }
pairing_payload() {
  local name stt=""
  name=$(hostname 2>/dev/null | head -n1 | tr -cd 'A-Za-z0-9._-' | head -c 63 || true)
  # --for desktop: NO stt object at all (docs/pairing.md: stt is optional), so
  # the STT token never leaves the phone's pairing code.
  if [[ "$pair_for" == phone ]]; then
    stt=$(printf ',"stt":{"url":"%s","token":"%s"}' \
      "$(url_for "$(pairing_host)" "$(get STT_PORT)")" "$(get STT_API_TOKEN)")
  fi
  printf '{"v":%d,"type":"promptshipper-pairing","name":"%s"%s,"clip":{"url":"%s","token":"%s"}}' \
    "$PAIRING_VERSION" "${name:-promptshipper}" "$stt" \
    "$(url_for "$(pairing_host)" "$(get CLIP_PORT)")" "$(get CLIPSTORE_TOKEN)"
}
QRENCODE_HINT="install qrencode (Debian/Ubuntu: apt install qrencode · Fedora: dnf install qrencode · macOS: brew install qrencode · Nix: nix-shell -p qrencode)"
# 🔴 qrencode must be LOCAL. An earlier version fell back to piping the payload
# (both tokens) into a network-fetched alpine container; that sends secrets into
# an unpinned image for the sake of a convenience one package install replaces.
print_qr() {
  local payload=$1
  ((qr)) || return 0
  if command -v qrencode >/dev/null 2>&1; then
    printf '%s' "$payload" | qrencode -t ANSIUTF8 -m 2
  else
    echo "(${QRENCODE_HINT} to see a QR code here; the payload below is the same thing)"
  fi
}
write_qr_png() { # payload path — the payload goes only into the file, never to a stream
  local payload=$1 path=$2 tmp
  command -v qrencode >/dev/null 2>&1 || die "--qr-png needs qrencode: ${QRENCODE_HINT}" 5
  tmp=$(umask 077 && mktemp "${path}.XXXXXX") || die "cannot create a file next to ${path}" 5
  printf '%s' "$payload" | qrencode -t PNG -m 2 -s 8 -o "$tmp" 2>/dev/null || true
  # A PNG starts with these 8 bytes; anything else (empty, an error) is a failure.
  if [[ "$(head -c 8 "$tmp" | od -An -tx1 | tr -d ' \n')" != 89504e470d0a1a0a ]]; then
    rm -f "$tmp"
    die "could not render the pairing QR as a PNG with qrencode" 5
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$path"
}
print_pairing() {
  local payload
  [[ -n "$(get STT_API_TOKEN)" && -n "$(get CLIPSTORE_TOKEN)" && -n "$(get PROMPTSHIPPER_HOST)" ]] \
    || die "no complete configuration in ${ENV_FILE}; run ./setup first"
  payload=$(pairing_payload)
  if ! is_private "$(pairing_host)"; then
    echo "setup: warning: the pairing address $(pairing_host) is not a private-network address." >&2
    echo "       The app only allows plain HTTP to private addresses (docs/pairing.md), so it" >&2
    echo "       will refuse this pairing. Use a Tailscale/LAN address, or put a TLS proxy in front." >&2
  fi
  if [[ -n "$qr_png" ]]; then
    # 🔴 For agent-run installs: only the PATH is printed. The payload holds
    # both tokens and must not reach stdout/stderr, which an agent reads.
    write_qr_png "$payload" "$qr_png"
    echo
    echo "Pairing QR code written to: ${qr_png}"
    echo "Open that image and scan it with the device you are pairing. It contains"
    echo "secret tokens: treat it like a password, and delete it once you have paired."
    return 0
  fi
  echo
  if [[ "$pair_for" == desktop ]]; then
    echo "Desktop pairing (clip server only — no STT token): give this to snip / the MCP server."
  else
    echo "Pair your phone: open the app, choose \"Pair with a server\" and scan this code."
  fi
  print_qr "$payload"
  [[ "$pair_for" == phone ]] && echo "STT server:  $(url_for "$(pairing_host)" "$(get STT_PORT)")"
  echo "Clip server: $(url_for "$(pairing_host)" "$(get CLIP_PORT)")"
  echo "The code contains your tokens: treat it like a password."
  echo "PAIRING_PAYLOAD=${payload}"
}

if ((pairing_only)); then
  print_pairing
  exit 0
fi

# ---------------------------------------------------------------- prerequisites
compose=()
if ((start)); then
  command -v docker >/dev/null 2>&1 || die "docker is not installed (https://docs.docker.com/engine/install/)" 2
  if docker compose version >/dev/null 2>&1; then
    compose=(docker compose)
  elif command -v docker-compose >/dev/null 2>&1; then
    compose=(docker-compose)
  else
    die "docker compose is not installed (the compose plugin, or docker-compose)" 2
  fi
  docker info >/dev/null 2>&1 || die "the docker daemon is not reachable (is it running? is this user in the docker group?)" 2
  command -v curl >/dev/null 2>&1 || die "curl is required for the health check" 2
fi

# ---------------------------------------------------------------- settings
detect_host() {
  local ip=""
  if command -v tailscale >/dev/null 2>&1; then
    ip=$(tailscale ip -4 2>/dev/null | head -n1 || true)
  fi
  if [[ -z "$ip" ]] && command -v ip >/dev/null 2>&1; then
    ip=$(ip -4 route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n1 || true)
  fi
  if [[ -z "$ip" ]] && command -v hostname >/dev/null 2>&1; then
    ip=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
  fi
  # Only an IPv4 literal counts as detected: a tool that printed something
  # else (an error, a name) must not become the address in the QR code.
  is_ipv4 "$ip" && printf '%s' "$ip"
  return 0
}

host=${opt_host:-$(get PROMPTSHIPPER_HOST)}
[[ -n "$host" ]] || host=$(detect_host)
[[ -n "$host" ]] || die "could not detect this machine's address; pass --host <ip-or-name>"
[[ "$host" =~ ^[A-Za-z0-9.:-]+$ ]] || die "--host must be an IP address or a DNS name: $host"
prev_host=$(get PROMPTSHIPPER_HOST)
cfg[PROMPTSHIPPER_HOST]=$host

# The address the phone is told to use. v1 pairing carries an IP literal: the
# app allows plain HTTP only to private ADDRESSES, which a name cannot prove.
addr=$(address_of "$host")
[[ -n "$addr" ]] || die "could not resolve --host ${host} to an address; pass an IP address, or check the name"
cfg[PAIRING_HOST]=$addr
[[ "$addr" != "$host" ]] && say "${host} resolves to ${addr}; the pairing code uses the address"

# 🔴 THE BIND ADDRESS IS NEVER SILENTLY 0.0.0.0. Precedence:
#   1. --bind (explicit; a wildcard gets a loud warning)
#   2. a BIND that was set by hand (no BIND_AUTO=1 beside it) — kept, always
#   3. the previous automatic BIND, while --host is unchanged
#   4. derived from --host: its address, but ONLY if that is private —
#      a public address is refused, because these services speak plain HTTP.
bind_auto=""
if [[ -n "$opt_bind" ]]; then
  bind=$opt_bind
  is_ip "$bind" || die "--bind must be an IP address: ${bind}"
elif [[ -n "$(get BIND)" && "$(get BIND_AUTO)" != 1 ]]; then
  bind=$(get BIND)
elif [[ -n "$(get BIND)" && "$host" == "$prev_host" ]]; then
  bind=$(get BIND) bind_auto=1
else
  is_private "$addr" || die "${host} is a public address (${addr}). These services speak plain HTTP with bearer tokens, so setup will not publish them there on its own. Use a private address (Tailscale, LAN) as --host, or pass --bind <addr> explicitly if a TLS proxy fronts them."
  bind=$addr bind_auto=1
fi
if is_wildcard "$bind"; then
  echo "setup: WARNING: --bind ${bind} publishes plain-HTTP services on EVERY network interface of" >&2
  echo "       this machine. Only do this behind a firewall or a TLS proxy — never on an" >&2
  echo "       internet-facing host." >&2
elif ! is_private "$bind"; then
  echo "setup: WARNING: --bind ${bind} is a public address; the services speak plain HTTP." >&2
fi
cfg[BIND]=$bind
cfg[BIND_AUTO]=$bind_auto
cfg[STT_PORT]=${opt_stt_port:-$(get STT_PORT)}
cfg[STT_PORT]=${cfg[STT_PORT]:-8118}
cfg[CLIP_PORT]=${opt_clip_port:-$(get CLIP_PORT)}
cfg[CLIP_PORT]=${cfg[CLIP_PORT]:-8139}
[[ "${cfg[STT_PORT]}" != "${cfg[CLIP_PORT]}" ]] || die "--stt-port and --clip-port must differ"

profile=${opt_profile:-$(get COMPOSE_PROFILES)}
profile=${profile:-cpu}
[[ "$profile" == cpu || "$profile" == gpu ]] || die "COMPOSE_PROFILES in ${ENV_FILE} must be cpu or gpu"
cfg[COMPOSE_PROFILES]=$profile
cfg[STT_BACKEND]=${opt_backend:-$(get STT_BACKEND)}
cfg[STT_BACKEND]=${cfg[STT_BACKEND]:-faster-whisper}
[[ -n "$opt_model" ]] && cfg[STT_MODEL]=$opt_model
[[ -n "$opt_upstream" ]] && cfg[STT_UPSTREAM_URL]=$opt_upstream
if [[ "${cfg[STT_BACKEND]}" == openai && -z "$(get STT_UPSTREAM_URL)" && "$profile" == cpu ]]; then
  die "--backend openai needs --upstream-url http://host:port"
fi
cfg[PULL_POLICY]=$(get PULL_POLICY); cfg[PULL_POLICY]=${cfg[PULL_POLICY]:-build}
cfg[PROMPTSHIPPER_VERSION]=$(get PROMPTSHIPPER_VERSION); cfg[PROMPTSHIPPER_VERSION]=${cfg[PROMPTSHIPPER_VERSION]:-latest}

new_token() {
  if command -v openssl >/dev/null 2>&1; then
    openssl rand -hex 32
  else
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n'
  fi
}
rotated=0
for key in STT_API_TOKEN CLIPSTORE_TOKEN; do
  if ((rotate)) || [[ -z "$(get "$key")" ]]; then
    cfg[$key]=$(new_token)
    rotated=1
  fi
  [[ "${cfg[$key]}" =~ ^[A-Za-z0-9._~-]{24,}$ ]] \
    || die "${key} in ${ENV_FILE} must be at least 24 URL-safe characters; run ./setup --rotate"
done

# ---------------------------------------------------------------- write .env
mkdir -p "$(dirname "$ENV_FILE")"
tmp=$(mktemp "${ENV_FILE}.XXXXXX")
{
  echo "# Written by ./setup. Re-run ./setup to change it (your tokens are kept;"
  echo "# --rotate replaces them). Contains secrets: never commit or share this file."
  for key in "${MANAGED_KEYS[@]}"; do
    [[ -n "${cfg[$key]:-}" ]] && printf '%s=%s\n' "$key" "${cfg[$key]}"
  done
  if ((${#extra_lines[@]})); then
    echo "# --- your own settings (kept by ./setup) ---"
    printf '%s\n' "${extra_lines[@]}"
  fi
} >"$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$ENV_FILE"
say "wrote ${ENV_FILE}$( ((rotated)) && echo ' (new tokens)')"

# Where compose mounts it (./snippets relative to deploy/compose), whatever --env-file says.
snip_dir="${COMPOSE_DIR}/snippets"
if [[ ! -f "${snip_dir}/snippets.json" ]]; then
  mkdir -p "$snip_dir"
  cp "$EXAMPLE_SNIPPETS" "${snip_dir}/snippets.json"
  say "seeded ${snip_dir}/snippets.json with the example catalog — edit it to make it yours"
fi

if ((!start)); then
  say "--no-start: nothing started"
  print_pairing
  exit 0
fi

# ---------------------------------------------------------------- start
dc() { "${compose[@]}" --project-directory "$COMPOSE_DIR" -f "${COMPOSE_DIR}/docker-compose.yml" --env-file "$ENV_FILE" "$@"; }
if [[ "$profile" == gpu ]]; then active=stt-gpu inactive=stt; else active=stt inactive=stt-gpu; fi
# Switching cpu<->gpu: stop the other variant (they publish the same port).
COMPOSE_PROFILES=cpu,gpu dc rm --stop --force "$inactive" >/dev/null 2>&1 || true
build=()
[[ "${cfg[PULL_POLICY]}" == build ]] && build=(--build)
say "starting clip and ${active} (profile ${profile}); the first build takes a few minutes"
COMPOSE_PROFILES=$profile dc up -d "${build[@]}" clip "$active"

# ---------------------------------------------------------------- verify
probe_host=$bind
[[ "$probe_host" == 0.0.0.0 ]] && probe_host=127.0.0.1
[[ "$probe_host" == "::" ]] && probe_host=::1
stt_probe=$(url_for "$probe_host" "${cfg[STT_PORT]}")
clip_probe=$(url_for "$probe_host" "${cfg[CLIP_PORT]}")

wait_healthy() { # name url
  local name=$1 url=$2 waited=0 code
  while :; do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "${url}/healthz" || true)
    [[ "$code" == 200 ]] && { say "${name} is healthy (${url})"; return 0; }
    if ((waited >= timeout)); then
      echo "setup: ${name} did not become healthy within ${timeout}s (last status: ${code:-none})." >&2
      echo "       Look at:  docker compose --project-directory ${COMPOSE_DIR} logs --tail 50 ${3}" >&2
      exit 3
    fi
    ((waited > 0 && waited % 30 == 0)) && say "waiting for ${name} (${waited}s; the first start downloads the model)..."
    sleep 2
    waited=$((waited + 2))
  done
}
wait_healthy clip "$clip_probe" clip
wait_healthy stt "$stt_probe" "$active"

# The bearer header goes to curl through a 0600 file (`-H @file`), never argv,
# where any local user could read it from the process table.
hdr_dir=$(umask 077 && mktemp -d)
trap 'rm -rf "$hdr_dir"' EXIT
check_auth() { # name url token
  local code
  (umask 077 && printf 'Authorization: Bearer %s\n' "$3" >"${hdr_dir}/h")
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -H "@${hdr_dir}/h" "$2" || true)
  rm -f "${hdr_dir}/h"
  [[ "$code" == 200 ]] || { echo "setup: $1 is up but answered ${code} to its own token at $2" >&2; exit 4; }
}
check_auth clip "${clip_probe}/v1/clips?limit=1" "${cfg[CLIPSTORE_TOKEN]}"
check_auth stt "${stt_probe}/v1/snippets" "${cfg[STT_API_TOKEN]}"
say "both services accept their tokens"

if [[ "$probe_host" != "$addr" ]]; then
  if ! curl -s -o /dev/null --max-time 5 "$(url_for "$addr" "${cfg[STT_PORT]}")/healthz"; then
    echo "setup: warning: the phone's address $(url_for "$addr" "${cfg[STT_PORT]}") is not reachable from this machine." >&2
    echo "       Check --host / --bind (the ports are published on ${bind})." >&2
  fi
fi

print_pairing
